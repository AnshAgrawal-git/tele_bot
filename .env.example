BOT_TOKEN=your-bot-token-from-botfather
ADMIN_GROUP_ID=-1004349789648
PORT=8080
# Password for the web CRM login (leave empty to disable login)
CRM_PASSWORD=
# Optional: where the SQLite file lives (use a persistent disk path on Render paid, e.g. /var/data/leads.db)
DB_PATH=
# Set to 0 to run only the web CRM locally (avoids TelegramConflictError while Render is running)
RUN_BOT=1
